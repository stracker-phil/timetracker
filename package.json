{
  "name": "timetracker",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first automatic time tracker for macOS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun run test:ui && bun run test:rust",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:db": "cargo test --manifest-path src-tauri/Cargo.toml -- --ignored",
    "lint": "bun run types && git diff --exit-code -- src/api/types.gen.ts && tsc --noEmit && eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --lib --bins -- -D warnings",
    "types": "PATH=/opt/homebrew/opt/rustup/bin:$PATH cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "build:app": "VITE_DEV_HOOKS=1 tauri build --debug --bundles app --config src-tauri/tauri.debug.conf.json",
    "release": "tauri build && scripts/install.sh",
    "app": "bun run build:app && open 'src-tauri/target/debug/bundle/macos/TimeTracker (Debug).app'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
